{
  "name": "@kadai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file src/db/schema.generated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@kadai/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "close-with-grace": "^2.5.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.9.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.13",
    "kysely": "^0.28.18",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.18.5",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
