# =============================================================================
# Kadai — environment configuration (see docs/ARCHITECTURE.md §19)
# Copy to .env for local development:  cp .env.example .env
# The secrets below are DEVELOPMENT-ONLY sample values. Generate fresh ones for
# every real deployment:
#   JWT_SECRET:            openssl rand -base64 48
#   KADAI_ENCRYPTION_KEYS: echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# =============================================================================

# --- Deployment mode ---------------------------------------------------------
# cloud  = multi-tenant SaaS (self-signup, plans & subscriptions)
# onprem = single-tenant shop server (setup wizard, signed license file)
KADAI_MODE=cloud
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Runtime pool: RLS-enforced role used for every tenant request & job.
DATABASE_URL=postgres://kadai_app:kadai_app@localhost:5432/kadai
# System pool: table-owner role for migrations, cross-tenant lookups, signup, webhooks.
# Defaults to DATABASE_URL when unset (a warning is logged).
DATABASE_SYSTEM_URL=postgres://kadai_owner:kadai_owner@localhost:5432/kadai
# Role that the migrator grants runtime privileges to.
DATABASE_APP_ROLE=kadai_app
DATABASE_POOL_MAX=20
# Apply pending migrations at boot (default: true onprem, false cloud).
KADAI_MIGRATE_ON_BOOT=true

# Integration tests (Vitest global setup migrates this database).
TEST_DATABASE_URL=postgres://kadai_app:kadai_app@localhost:5432/kadai_test
TEST_DATABASE_SYSTEM_URL=postgres://kadai_owner:kadai_owner@localhost:5432/kadai_test

# --- Security ----------------------------------------------------------------
# HS256 signing secret for access tokens (>= 32 bytes).
JWT_SECRET=3tc_iSo2rrdIagT9-IltF7LT9whT59DgJxRaVaQm8Lbo36rMr_E5yUlja2ceKEpf
# AES-256-GCM keys for provider credentials: kid:base64(32 bytes)[,kid2:...]
# The first key encrypts; all listed keys can decrypt (rotation).
KADAI_ENCRYPTION_KEYS=dev1:EzCKv9Lam1aOcV2/Rcaz2K5tRz7kBwxXbRoQ9seMX38=
# Comma separated list of allowed browser origins (cloud). Empty = same-origin only.
CORS_ORIGINS=http://localhost:5173
# Bearer token required by GET /metrics (empty = metrics endpoint open; set in production).
METRICS_TOKEN=
# Serve Swagger UI at /api/docs outside development.
KADAI_API_DOCS=false

# --- URLs & files ------------------------------------------------------------
# Base URL used in messages (invoice links, payment links) and webhook URLs.
PUBLIC_BASE_URL=http://localhost:8080
# Local files, backups (onprem) and uploads when S3 is not configured.
KADAI_DATA_DIR=./data
# Serve the built web app (apps/web/dist) from the API process.
KADAI_SERVE_WEB=true
# Run the background worker inside the API process (default: true onprem).
KADAI_EMBEDDED_WORKER=true

# S3-compatible object storage (cloud). Leave S3_BUCKET empty to use local disk.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional Redis for shared rate-limit/cache state across API pods (cloud).
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# --- On-prem licensing -------------------------------------------------------
# Ed25519 public key (PEM or base64 SPKI) to verify license files. Empty = built-in key.
KADAI_LICENSE_PUBLIC_KEY=

# --- Payments ----------------------------------------------------------------
# Enables the "mock" payment provider and POST /payments/intents/:id/mock-pay (dev/test only).
KADAI_ENABLE_MOCK_PAYMENTS=true
# SaaS vendor billing through Razorpay Subscriptions (cloud only).
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
RAZORPAY_PLATFORM_WEBHOOK_SECRET=

# --- Notifications -----------------------------------------------------------
# SMS: log (prints to the server log) | msg91
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_ENTITY_ID=
MSG91_OTP_TEMPLATE_ID=
# WhatsApp: log | whatsapp_cloud (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Email: log | smtp
EMAIL_PROVIDER=log
SMTP_URL=
SMTP_FROM=Kadai <no-reply@localhost>

# --- Observability -----------------------------------------------------------
# OpenTelemetry OTLP endpoint (optional), e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
