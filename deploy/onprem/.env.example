# =============================================================================
# Kadai on-premise (Docker Compose) settings — copy to .env next to docker-compose.yml.
# install-linux.sh creates .env automatically with freshly generated secrets.
#
# Manual setup: replace every CHANGE_ME with a NEW random value (never reuse these lines):
#   POSTGRES_PASSWORD / KADAI_DB_OWNER_PASSWORD / KADAI_DB_APP_PASSWORD:
#       openssl rand -hex 24                      (hex: safe inside connection URLs)
#   JWT_SECRET:
#       openssl rand -base64 48
#   KADAI_ENCRYPTION_KEYS:
#       echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# Keep a copy of this file in a safe place: without KADAI_ENCRYPTION_KEYS the stored payment
# provider credentials cannot be decrypted after a restore. chmod 600 .env
# =============================================================================

COMPOSE_PROJECT_NAME=kadai

# Container image (pin a release; the release bundle sets this line for you).
KADAI_IMAGE=ghcr.io/jayeskumar/my_shop:latest

# LAN address that counter PCs and printed links use (this PC's name or fixed IP).
PUBLIC_BASE_URL=http://kadai-server:8080
KADAI_HTTP_PORT=8080
KADAI_HTTP_BIND=0.0.0.0
TZ=Asia/Kolkata
LOG_LEVEL=info

# Host folder for uploaded files, logs and backups (bind-mounted at /data, owner uid 10001).
KADAI_DATA_PATH=./data

# --- Secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
KADAI_DB_OWNER_PASSWORD=CHANGE_ME
KADAI_DB_APP_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
KADAI_ENCRYPTION_KEYS=CHANGE_ME
# Bearer token for GET /metrics (optional on a LAN; openssl rand -hex 24).
METRICS_TOKEN=

# --- PostgreSQL sizing (defaults suit a 4–8 GB shop PC) ------------------------
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB

# --- Optional LAN HTTPS (docker compose --profile tls up -d) --------------------
# Names/IPs the counter PCs type in the browser, comma separated.
KADAI_TLS_SITES=localhost
KADAI_HTTPS_PORT=443
KADAI_TLS_HTTP_PORT=80
# Private network used by the containers (change only if it clashes with your LAN).
KADAI_DOCKER_SUBNET=172.31.250.0/24

# --- Messaging (optional; "log" only writes messages to the server log) --------
# India: SMS needs DLT registration (entity id + approved template ids), see DEPLOYMENT.md.
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_ENTITY_ID=
MSG91_OTP_TEMPLATE_ID=
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
EMAIL_PROVIDER=log
SMTP_URL=
SMTP_FROM=Kadai <no-reply@localhost>

# --- Host backups (backup.sh / restore.sh) -------------------------------------
# Default folder: $KADAI_DATA_PATH/backups. Optional second copy (USB drive, NAS mount).
KADAI_BACKUP_DIR=
KADAI_BACKUP_COPY_TO=
KADAI_BACKUP_RETENTION_DAYS=30
KADAI_BACKUP_KEEP_MIN=7
