KADAI_MODE=cloud
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080
DATABASE_APP_ROLE=kadai_app
DATABASE_POOL_MAX=15
DATABASE_SYSTEM_POOL_MAX=5
KADAI_MIGRATE_ON_BOOT=false
KADAI_EMBEDDED_WORKER=false
KADAI_HEALTH_REQUIRE_WORKER=false
KADAI_SERVE_WEB=true
KADAI_DATA_DIR=/data
TRUST_PROXY=1
PUBLIC_BASE_URL=https://app.example.in
CORS_ORIGINS=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
WHATSAPP_API_VERSION=v21.0
EMAIL_PROVIDER=log
SMTP_FROM=Kadai <no-reply@example.in>
KADAI_API_DOCS=false
OTEL_EXPORTER_OTLP_ENDPOINT=
