# =============================================================================
# Kadai cloud (Docker Compose) settings — copy to .env next to docker-compose.yml, chmod 600.
# Generate every secret freshly for each environment:
#   POSTGRES_PASSWORD / KADAI_DB_*_PASSWORD / METRICS_TOKEN:  openssl rand -hex 24
#   JWT_SECRET:                                               openssl rand -base64 48
#   KADAI_ENCRYPTION_KEYS:          echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# Configuration reference: docs/ARCHITECTURE.md §19 and docs/DEPLOYMENT.md.
# =============================================================================

COMPOSE_PROJECT_NAME=kadai-cloud
# "db" runs PostgreSQL in this compose project. With a managed database (RDS, Cloud SQL, …)
# set COMPOSE_PROFILES= (empty) and fill DATABASE_URL / DATABASE_SYSTEM_URL below.
COMPOSE_PROFILES=db

KADAI_IMAGE=ghcr.io/jayeskumar/my_shop:latest
KADAI_DOMAIN=app.example.in
ACME_EMAIL=ops@example.in
KADAI_API_REPLICAS=2
KADAI_WORKER_REPLICAS=1
LOG_LEVEL=info
# Extra browser origins allowed to call the API (same-origin needs nothing).
CORS_ORIGINS=

# --- Database ----------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
KADAI_DB_OWNER_PASSWORD=CHANGE_ME
KADAI_DB_APP_PASSWORD=CHANGE_ME
# External database (leave empty for the bundled "db" service). Use sslmode=verify-full.
DATABASE_URL=
DATABASE_SYSTEM_URL=
DATABASE_POOL_MAX=20
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB

# --- Secrets -----------------------------------------------------------------
JWT_SECRET=CHANGE_ME
KADAI_ENCRYPTION_KEYS=CHANGE_ME
METRICS_TOKEN=CHANGE_ME

# --- Object storage (uploads, exports). Empty S3_BUCKET = local volume. --------
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Messaging (India: SMS requires DLT registration, see DEPLOYMENT.md) --------
SMS_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_ENTITY_ID=
MSG91_OTP_TEMPLATE_ID=
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
EMAIL_PROVIDER=log
SMTP_URL=
SMTP_FROM=Kadai <no-reply@example.in>

# --- SaaS billing (Razorpay Subscriptions for the vendor's own plans) -----------
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
RAZORPAY_PLATFORM_WEBHOOK_SECRET=

# --- Observability ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
